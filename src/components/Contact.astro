---
import { person } from '../data/site';
---

<section id="contacto" class="relative overflow-hidden bg-brand-dark py-28 text-brand-light">
  <div class="absolute top-0 right-0 -mt-20 -mr-20 h-96 w-96 rounded-full bg-brand-accent/10 blur-3xl"></div>

  <div class="relative z-10 mx-auto max-w-4xl px-4 text-center">
    <span class="mb-4 block text-sm font-semibold tracking-wider text-brand-accent uppercase">Hablemos</span>
    <h2 class="mb-8 font-display text-4xl font-bold sm:text-5xl md:text-7xl">¿Le damos un propósito a tu marca?</h2>
    <p class="mx-auto mb-12 max-w-2xl text-lg font-light text-gray-300 md:text-xl">
      Si buscas a alguien que construya tu marca, planee tu contenido y mida lo que funciona, escríbeme.
    </p>

    <a href={`mailto:${person.email}`} class="inline-block max-w-full rounded-full bg-brand-accent px-6 py-4 text-base font-bold break-all text-brand-dark shadow-xl shadow-brand-accent/20 transition-transform duration-300 hover:scale-105 sm:px-12 sm:py-5 sm:text-lg">
      {person.email}
    </a>

    <ul class="mt-10 flex flex-col items-center justify-center gap-4 text-sm sm:flex-row sm:gap-8">
      <li>
        <a href={person.whatsapp} target="_blank" rel="noopener" class="nav-link font-medium">WhatsApp {person.phone}</a>
      </li>
      <li>
        <a href={person.linkedin} target="_blank" rel="noopener" class="nav-link font-medium">LinkedIn</a>
      </li>
      <li>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/${person.cv}`} download class="nav-link font-medium">Descargar CV (PDF)</a>
      </li>
      <li class="text-gray-400">{person.location}</li>
    </ul>
  </div>
</section>
