---
// Vitrina de las capturas de la página de Facebook: vista móvil y vistas de escritorio.
import { Image } from 'astro:assets';
import movil from '../assets/proyectos/animal-lovers/movil.png';
import pagina from '../assets/proyectos/animal-lovers/pagina.png';
import reels from '../assets/proyectos/animal-lovers/reels.png';
---

<div class="grid items-center gap-10 rounded-3xl bg-white p-6 shadow-sm md:p-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
  <figure class="mx-auto w-full max-w-[300px]">
    <div class="overflow-hidden rounded-[2.5rem] border-[10px] border-brand-dark bg-brand-dark shadow-2xl">
      <Image src={movil} alt="Página Animal Lovers vista desde el celular, con 64 mil seguidores" widths={[300, 600]} sizes="300px" class="h-auto w-full" />
    </div>
    <figcaption class="mt-4 text-center text-sm text-gray-600">Vista en el celular</figcaption>
  </figure>

  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
    <figure>
      <div class="overflow-hidden rounded-2xl border border-gray-200 shadow-lg">
        <Image src={pagina} alt="Portada de la página Animal Lovers en Facebook desde el computador" widths={[500, 940]} sizes="(min-width: 1280px) 30vw, (min-width: 640px) 45vw, 90vw" class="aspect-[10/9] h-auto w-full object-cover object-top" />
      </div>
      <figcaption class="mt-3 text-center text-sm text-gray-600">Portada de la página</figcaption>
    </figure>
    <figure>
      <div class="overflow-hidden rounded-2xl border border-gray-200 shadow-lg">
        <Image src={reels} alt="Cuadrícula de reels de Animal Lovers con sus visualizaciones" widths={[500, 876]} sizes="(min-width: 1280px) 30vw, (min-width: 640px) 45vw, 90vw" class="aspect-[10/9] h-auto w-full object-cover object-top" />
      </div>
      <figcaption class="mt-3 text-center text-sm text-gray-600">Estética de los reels publicados</figcaption>
    </figure>
  </div>
</div>
