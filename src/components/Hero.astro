---
import { Image } from 'astro:assets';
import photo from '../assets/daniela.jpg';
import { person } from '../data/site';
---

<section class="px-4 pt-32 pb-20 md:pt-44 md:pb-28">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-12 md:flex-row sm:px-2 lg:px-4">
    <div class="md:w-3/5">
      <span class="mb-4 flex items-center gap-2 text-xs font-semibold tracking-wider uppercase md:text-sm">
        <span class="inline-block h-px w-8 bg-brand-dark"></span>
        {person.role}
      </span>

      <h1 class="mb-6 font-display text-5xl leading-none font-bold text-brand-accent md:text-7xl lg:text-8xl">
        Estrategia que conecta.<br />
        Diseño que convierte.
      </h1>

      <p class="mb-8 max-w-2xl text-lg leading-relaxed text-gray-700 md:text-xl">
        Soy Daniela Tirado. Construyo marcas y contenido con un <strong>propósito claro</strong>: que se vean bien, que la gente las entienda y que los números lo demuestren. Hoy lidero la marca y el contenido de <strong>Outrix Intelligence</strong>.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="#proyectos" class="btn-primary">
          Ver mi trabajo
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
          </svg>
        </a>
        <a href="#contacto" class="btn-outline">Contactarme</a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-sm md:mx-0 md:w-2/5 md:max-w-md">
      <div class="group relative aspect-[4/5] overflow-hidden rounded-t-full rounded-b-3xl border-4 border-white bg-gray-200 shadow-2xl">
        <Image
          src={photo}
          alt="Retrato de Daniela Tirado con camisa blanca sobre fondo oscuro"
          widths={[360, 540, 720, 880]}
          sizes="(min-width: 768px) 40vw, 90vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover object-top"
        />
      </div>
      <div class="absolute -right-6 -bottom-6 -z-10 h-32 w-32 rounded-full bg-brand-accent opacity-50 blur-2xl"></div>
    </div>
  </div>
</section>
