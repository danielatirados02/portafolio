---
// Fila de KPIs: promedio mensual antes (ene–may) frente a después (jun–dic).
import { compare, compact, fmt, seriesMeta, type SeriesKey } from '../../lib/metrics';

interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
const keys: SeriesKey[] = ['visualizaciones', 'interacciones', 'seguidores', 'visitas'];
---

<dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {
    keys.map((k) => {
      const c = compare(k);
      return (
        <div class:list={['rounded-3xl p-6', dark ? 'bg-white/5 ring-1 ring-white/10' : 'border border-gray-100 bg-white shadow-sm']}>
          <dt class:list={['text-xs font-bold tracking-wider uppercase', dark ? 'text-gray-300' : 'text-gray-500']}>
            {seriesMeta[k].label} al mes
          </dt>
          <dd class="mt-3">
            <span class="font-display text-4xl font-bold md:text-5xl">{compact(c.afterAvg)}</span>
            <span class:list={['mt-2 block text-sm', dark ? 'text-gray-300' : 'text-gray-600']}>
              promedio jun–dic, frente a <strong class={dark ? 'text-white' : 'text-brand-dark'}>{fmt(c.beforeAvg)}</strong> en ene–may
            </span>
            <span class:list={['mt-3 block text-sm', dark ? 'text-gray-300' : 'text-gray-600']}>
              Total desde junio: <strong class={dark ? 'text-white' : 'text-brand-dark'}>{fmt(c.afterTotal)}</strong>
            </span>
          </dd>
        </div>
      );
    })
  }
</dl>
